# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/openbankx

# Redis (caching + optional session/rate-limit backing store)
# App runs fine without Redis reachable - caching just becomes a no-op.
REDIS_URL=redis://localhost:6379
CACHE_TTL_BLOCKCHAIN_CONFIG=3600
CACHE_TTL_BALANCE=15
CACHE_TTL_BANK_ACCOUNTS=60

# Scheduled jobs (node-cron, 5-field cron syntax)
CRON_ENABLED=true
CRON_BANK_REFRESH_SCHEDULE=0 */6 * * *
CRON_HEALTH_CHECK_SCHEDULE=*/5 * * * *

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Wallet auth (Module 2)
WALLET_SIGN_MESSAGE=Sign this message to authenticate with OpenBankX

# Google OAuth ("Sign in with Google") - create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials (type: Web application).
# Only the client ID is needed server-side; ID-token verification doesn't
# require the client secret. Leave blank to disable the /auth/google route.
GOOGLE_CLIENT_ID=

# Plaid (Module 3) - mock-ready, leave blank to use mock provider
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Bank token encryption - generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BANK_TOKEN_ENCRYPTION_KEY=

# Blockchain (Module 5+)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
VAULT_CONTRACT_ADDRESS=
SWAP_CONTRACT_ADDRESS=
MOCK_TOKEN_ADDRESS=
BACKFILL_BLOCK_RANGE=5000

# AI Assistant (Module 6) - leave ANTHROPIC_API_KEY blank to disable /api/ai/chat
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_AGENT_STEPS=5
AI_MAX_TOKENS=1024
# Optional real embeddings for RAG (via Voyage AI, Anthropic's recommended
# embeddings provider). Without this, retrieval falls back to a local
# TF-IDF vectorizer - fully functional, just lower quality than dense
# neural embeddings.
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-lite
